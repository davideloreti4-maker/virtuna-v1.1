# ============================================================================
# Virtuna Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_ vars are exposed to the browser — never put secrets there.
#
# ⚠️ NEXT_PUBLIC_* is INLINED AT BUILD TIME. Changing one on Vercel does nothing
#    until you REDEPLOY — setting the var alone never takes effect.
#
# This file is the LOCAL-DEV template. For which vars to set ON VERCEL (and which
# to deliberately leave unset), see docs/ENV.md.
# Verified against `grep process.env` over src/ on 2026-07-26.
# ============================================================================


# ============================================================================
# REQUIRED — the app does not work without these
# ============================================================================

# --- Supabase ---

NEXT_PUBLIC_SUPABASE_URL=       # Project URL from supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Anon/public key from the same page
SUPABASE_SERVICE_ROLE_KEY=      # Service role key (secret — never expose client-side)
                                # All three are read with `!` — missing means a runtime
                                # crash on the first DB call, not a friendly error.

# --- AI / LLM (Qwen via DashScope International) ---

DASHSCOPE_API_KEY=              # THE engine key. Code THROWS "Missing DASHSCOPE_API_KEY"
                                # without it — every LLM call routes through DashScope
                                # (Qwen-only pipeline). No key, no product.

# --- App URL ---

NEXT_PUBLIC_APP_URL=            # Local:  http://localhost:3000
                                # Vercel: the REAL production origin, e.g.
                                #         https://virtuna-v11.vercel.app
                                # ⚠️ Copying the localhost value into Vercel silently breaks
                                # Apify webhook callbacks and referral links.


# ============================================================================
# STRONGLY RECOMMENDED — these degrade SILENTLY, they do not crash
# ============================================================================

CRON_SECRET=                    # Random 32+ char string (`openssl rand -hex 32`).
                                # verifyCronAuth compares against `Bearer ${CRON_SECRET}`,
                                # so UNSET makes the expected header the literal string
                                # "Bearer undefined" — guessable. All 10 cron ROUTES stay
                                # publicly deployed even though vercel.json now schedules
                                # NONE of them. Set it regardless.

UPSTASH_REDIS_REST_URL=         # Rate limiting is FAIL-OPEN by design: unset means NO rate
UPSTASH_REDIS_REST_TOKEN=       # limiting at all, with one warning logged. Fine locally and
                                # while private — set both before public traffic.

FILMSTRIP_EXTRACT_SECRET=       # Bearer gate for /api/filmstrip/extract. Unset ⇒ the extract
                                # step aborts early (logged) and analyses run with NO
                                # keyframes — the Test card's filmstrip renders empty.

# --- Apify (TikTok / IG scraping) ---

APIFY_TOKEN=                    # console.apify.com > Account > Integrations. Unset ⇒ all
                                # scraping fails (Discover, competitor refresh, corpus).
APIFY_WEBHOOK_SECRET=           # Shared secret you generate. Sender and receiver both read
                                # THIS var, so any value is self-consistent — but unset ⇒ the
                                # webhook route rejects every inbound payload.

# --- Sentry (error tracking) ---

NEXT_PUBLIC_SENTRY_DSN=         # Sentry DSN from project settings. Unset ⇒ no error tracking.
SENTRY_ORG=                     # (optional, BUILD-TIME) source map upload — read in next.config.ts
SENTRY_PROJECT=                 # (optional, BUILD-TIME) same


# ============================================================================
# FEATURE FLAGS — note the polarity, it is NOT uniform
# ============================================================================

NEXT_PUBLIC_AMBIENT_V2=         # "true" enables the Ambient Audience v2 room. Defaults OFF.
                                # BUILD-TIME inlined ⇒ flipping it needs a redeploy.

BILLING_ENFORCE_QUOTA=          # "true" enforces the credits meter. Defaults OFF, and stays
                                # off in production until the Whop step (docs/PRICING.md).

GROUNDING_HOOKS_ENABLED=        # These three default OFF — they need an explicit "true".
GROUNDING_IDEAS_ENABLED=
GROUNDING_SCRIPT_ENABLED=

# CHAT_AGENT_DISPATCH           # ⚠️ opposite polarity — defaults ON, set "false" to disable
# GROUNDING_CHAT_TOOL           # defaults ON
# GROUNDING_CHAT_PREFLIGHT      # defaults ON


# ============================================================================
# WHOP (payments) — absent BY DESIGN until launch
# ============================================================================
# A missing PRODUCT id makes checkout return 503; a missing TRIAL id degrades to
# full price and never undercharges. Leaving all of these unset is the safe state.

WHOP_API_KEY=                   # Whop dashboard > Developer settings > API key
WHOP_WEBHOOK_SECRET=            # Webhook signing secret
WHOP_PRODUCT_ID_STARTER=        # Product id — Starter
WHOP_PRODUCT_ID_PRO=            # Product id — Pro
WHOP_PRODUCT_ID_STUDIO=         # Product id — Studio
WHOP_TRIAL_PLAN_ID_STARTER=     # Trial plan id — Starter
WHOP_TRIAL_PLAN_ID_PRO=         # Trial plan id — Pro
WHOP_TRIAL_PLAN_ID_STUDIO=      # Trial plan id — Studio


# ============================================================================
# OPTIONAL OVERRIDES — every one has an in-code default; skip unless tuning
# ============================================================================
# Model pins:  FOLD_MODEL · FLASH_MODEL · EMBEDDING_MODEL
#              QWEN_APOLLO_MODEL · QWEN_DECODE_MODEL · QWEN_OMNI_MODEL
#              QWEN_REASONING_MODEL · QWEN_EMBEDDING_MODEL
# Fold tuning: FOLD_TEMPERATURE · FOLD_MAX_TOKENS · FOLD_ATTEMPT_TIMEOUT_MS
#              FOLD_DIVERSITY_RETRY_TEMP · OMNI_MAX_TOKENS · DEEPSEEK_THINKING_BUDGET
# Grounding:   GROUNDING_HOOKS_{ADAPT,RANK,SURFACE} · GROUNDING_IDEAS_ADAPT
#              GROUNDING_SCRIPT_ADAPT · GROUNDING_WARRANT_MIN_SIMILARITY
#              GROUNDING_REF_MIN_SIMILARITY
# Scraping:    APIFY_ACTOR_ID (default clockworks~tiktok-scraper) · APIFY_ACTOR_LEGACY
#              SCRAPER_HASHTAGS
# Dev only:    NEXT_PUBLIC_REACT_SCAN


# ============================================================================
# DEAD / DO NOT SET
# ============================================================================
# DEEPSEEK_API_KEY   — no runtime reader left anywhere in src/ (Qwen-only pipeline).
# GEMINI_API_KEY     — its ONLY reader was the calculate-trends cron. With every cron
#                      schedule removed from vercel.json it is not needed at all.
#
# Local research scripts ONLY — never set these on Vercel:
#   AB_* · SWEEP_BUDGETS · SPIKE_REAL · SMOKE_ASK · RUN_VISION_LIVE_SMOKE
#   GATE_MODEL · PASS2_THINKING_BUDGET · QWEN_FAST_MODEL · OUT · T · YAW · PITCH
