{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = \"production\" ] && exit 1 || exit 0",
  "functions": {
    "src/app/api/analyze/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-whop",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/delete-retained-videos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sweep-orphan-videos",
      "schedule": "0 4 * * 0"
    }
  ]
}
